# Color
export CLICOLOR=1

# Editor
export EDITOR=vim
export VISUAL=vim

# cursor cli / local bin
export PATH="$HOME/.local/bin:$PATH"

# Docker CLI の補完（Docker Desktop が追記する設定の置き換え）
#   prezto の completion モジュールが compinit を呼ぶので、その前に fpath へ足す
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# Source Prezto
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# bun（インストール済みの場合のみ）
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
fi

# safe-chain（npm セキュリティ。インストール済みの場合のみ）
[[ -f "$HOME/.safe-chain/scripts/init-posix.sh" ]] && \
  source "$HOME/.safe-chain/scripts/init-posix.sh"

# PC固有の設定を読み込む
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Added by Antigravity CLI installer
export PATH="/Users/uirikuto/.local/bin:$PATH"

# inshellisense（Fig風の補完ポップアップ。brew install inshellisense 後に有効）
# 他のコマンドが設定を壊すため、必ずファイルの最後に置くこと
[[ -f "$HOME/.local/share/inshellisense/init/zsh/init.zsh" ]] && \
  source "$HOME/.local/share/inshellisense/init/zsh/init.zsh"
